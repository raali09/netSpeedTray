{
  "name": "netspeedtray",
  "version": "2.13.0",
  "description": "آزمونگر سرعت اینترنت — ویجت ویندوزی و وب‌اپ با اندازه‌گیری واقعی سرعت و تشخیص صریح قطعی اینترنت (Next.js + Electron + Prisma)",
  "private": true,
  "author": "raali09",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "build:electron": "prisma db push --skip-generate && next build && node scripts/postbuild.mjs && electron-builder --win --publish never",
    "desktop:dev": "electron electron/main.js"
  },
  "trustedDependencies": [
    "electron",
    "prisma",
    "@prisma/client",
    "@prisma/engines",
    "unrs-resolver",
    "esbuild",
    "@tailwindcss/oxide"
  ],
  "dependencies": {},
  "devDependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "zod": "^4.0.2"
  }
}
